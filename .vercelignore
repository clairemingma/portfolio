# Vercel builds from the repository, so this should never be the only thing
# standing between an excluded file and the deploy. It is here so that a deploy
# run from a local directory cannot publish what the repository deliberately
# omits either.

node_modules
dist
scripts/.manifests
scripts/.verify

# Nothing else is held back: all three project pages ship and all three are
# linked from the landing index. Mirrors .gitignore; see the note there for how
# to hold one back again.
