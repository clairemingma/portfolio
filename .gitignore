node_modules
dist

# Build-time only: regenerated by npm run images / npm run build.
scripts/.manifests
scripts/.verify

# Generated from assets/ by scripts/build-images.mjs on every build, including
# Vercel's. Committing it would only be a second copy that can go stale.
public/img
public/video

# ---------------------------------------------------------------------------
# Held out of the repository on purpose — the Confidence Underneath project is
# not published yet.
#
# The build tolerates all of this being missing: vite.config.js only takes page
# inputs that exist, and both build scripts skip what is not in the checkout. So
# the deploy builds the landing page and nothing complains.
#
# To publish it: delete this section, restore the index row's href, and commit.
# ---------------------------------------------------------------------------
projects/confidence-underneath/
assets/projects/Dexcom x SKIMS Confidence Underneath/

# Source frames for a project that does not exist yet; nothing references them.
assets/projects/The Evolution of Color Trends in Runway Fashion/
.vercel
.env*
